---
/* Homepage.
 *
 * NOTE: homepage copy and section order were not recovered from the previous
 * site (inventory §8). What is confirmed: the positioning intent (independent
 * scientist-builder across biophysics, imaging, computation, quantitative
 * systems, and scientific tooling), the three flagship project summaries
 * (computational photography = bounded text only, no images/repo links), and
 * a notes listing. Everything below is restrained scaffolding built only
 * from confirmed facts — verify against the live site before finalizing. */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPublished } from '../lib/publication.mjs';

const notes = await getCollection('notes', isPublished);

// Base-aware links for local and legacy project-prefix builds.
const _base = import.meta.env.BASE_URL;
const base = _base.endsWith('/') ? _base : _base + '/';
---
<BaseLayout title="Nicholas Sisco — Independent Research & Engineering" description="Independent research and engineering across scientific software, physiology, evidence methods, and creative work." ogType="website">
  <h1>Nicholas Sisco — Independent Research &amp; Engineering</h1>
  <p class="lead">Independent scientist-builder working across biophysics, imaging, computation, quantitative systems, and scientific tooling. This site is a durable public record of independent work: evidence over performance, trajectory over snapshot.</p>
  <section id="projects"><h2 class="section-label">Projects</h2>
    <h3><a href={base + 'literature.html'}>Scientific Literature Intelligence Agent</a></h3><p>A local literature workflow that makes query approval, retrieval, source snapshots, normalization, deduplication, and later appraisal inspectable — with provenance-first records and human-authored appraisal.</p><p class="status-line"><strong>Status:</strong> Active development · Prototype</p>
    <h3><a href={base + 'odgs.html'}>Operational-Decay &amp; Growth Simulator (ODGS)</a></h3><p>A draft specification package asking whether operating productivity adds predictive information beyond conventional financial and market variables — specification and source-feasibility stage only, no model or result claimed.</p><p class="status-line"><strong>Status:</strong> Draft specification package · Concept / specification</p>
    <article class="card"><h3>Computational Photography &amp; Image Registration</h3><p>Develop a defensible, reusable computational-photography pipeline that can combine heterogeneous image stacks while preserving evidence, uncertainty, and the option to abstain when alignment or fusion is not trustworthy.</p><p>Real photographic stacks often differ in field of view, pose, focal point, exposure, and local image quality. A useful reconstruction system should not merely produce an attractive composite; it should know what evidence supports the result.</p><p class="fine">Bounded text summary only — no images, raw data, or repository links are published here until rights and a clean evidence destination are established.</p></article>
  </section>
  <section id="physiology"><h2 class="section-label">Physiology</h2><h3><a href={base + 'forged-fitness.html'}>Forged Fitness</a></h3><p>Learn the science of training, nutrition and recovery — and turn it into decisions you can use. An open course: 12 weeks, 36 lessons.</p><h3><a href={base + 'molecular-physiology.html'}>Molecular Physiology of Training</a></h3><p>A mechanistic atlas of how training, nutrition, and energetic state become biological adaptation.</p></section>
  <section id="notes"><h2 class="section-label">Research notes</h2>{notes.map((n) => <article class="card"><h3><a href={base + n.id.replace(/\.mdx$/, '') + '.html'}>{n.data.title}</a></h3><p>{n.data.description}</p><p class="status-line"><strong>Status:</strong> {n.data.status} · {n.data.maturity}</p></article>)}</section>
  <section id="methods"><h2 class="section-label">Methods</h2><p>Evidence over performance. Trajectory over snapshot.</p><p>Research notes separate questions, evidence, inference, limitations, and unresolved decisions. Project claims stay bounded by the available sources, rights, and implementation state.</p></section>
  <section id="writing"><h2 class="section-label">Writing</h2><ul><li><a href={base + 'problem-of-evil.html'}>The Problem of Evil</a> — philosophy of religion</li><li><a href={base + 'the-moment-is-over.html'}>The Moment Is Over</a> — short story</li></ul><p><a href={base + 'sci-fi-novels.html'}>Science fiction novels</a></p></section>
  <section id="about"><h2 class="section-label">About</h2><p>Independent research and engineering, with a focus on careful evidence, transparent methods, and useful tools.</p><p>Contact details are not currently published.</p></section>
</BaseLayout>
<style>
  .fine { color: var(--muted); font-size: 0.9rem; }
</style>
