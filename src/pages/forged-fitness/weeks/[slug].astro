---
/* Dynamic week overview pages: /forged-fitness/weeks/<slug>.html
 * Lesson cards and the companion-resource link are generated from the
 * content collections so they can never drift out of sync.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import CoursePage from '../../../layouts/CoursePage.astro';
import { isPublished } from '../../../lib/publication.mjs';

export async function getStaticPaths() {
  const weeks = (await getCollection('course-weeks', isPublished)).filter(isPublished);
  const lessons = (await getCollection('course-lessons', isPublished)).filter(isPublished);
  const stageOrder = { understand: 0, apply: 1, review: 2 };
  return weeks.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, '') },
    props: {
      entry,
      lessons: lessons
        .filter((l) => l.data.week === entry.data.week)
        .sort((a, b) => stageOrder[a.data.stage] - stageOrder[b.data.stage]),
    },
  }));
}

interface Props {
  entry: CollectionEntry<'course-weeks'>;
  lessons: CollectionEntry<'course-lessons'>[];
}

const { entry, lessons } = Astro.props;
const { Content } = await entry.render();
const eyebrow = `Week ${entry.data.week}`;
const lessonHref = (id: string) => `../lessons/${id.replace(/\.mdx$/, '')}.html`;
---
<CoursePage entry={entry} eyebrow={eyebrow}>
  <p data-week-progress={entry.data.week} role="status">
    Optional progress is saved only on this device.
  </p>
  <div class="grid">
    {lessons.map((l) => (
      <article class="card">
        <div class="week-number">{l.data.stage}</div>
        <h3><a href={lessonHref(l.id)}>{l.data.title}</a></h3>
        <p>{l.data.description}</p>
        <p class="small" data-lesson-state={l.data.lesson_id}></p>
      </article>
    ))}
  </div>
  <Content />
</CoursePage>
