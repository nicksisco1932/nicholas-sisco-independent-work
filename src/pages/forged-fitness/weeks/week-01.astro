---
import { getEntry, render } from 'astro:content';
import CoursePage from '../../../layouts/CoursePage.astro';

const entry = await getEntry('courseWeeks', 'week-01');
if (!entry) throw new Error('Missing course week: week-01');
const { Content } = await render(entry);
---
<CoursePage entry={entry} kind="week">
  <Content />
</CoursePage>
