---
import { getEntry, render } from 'astro:content';
import CoursePage from '../../../../layouts/CoursePage.astro';

const entry = await getEntry('courseResources', 'baseline');
if (!entry) throw new Error('Missing course resource: baseline');
const { Content } = await render(entry);
---
<CoursePage entry={entry} kind="resource">
  <Content />
</CoursePage>
