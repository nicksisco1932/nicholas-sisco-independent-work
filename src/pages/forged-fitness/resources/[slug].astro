---
/* Dynamic worksheet pages: /forged-fitness/resources/<slug>.html */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CoursePage from '../../../layouts/CoursePage.astro';
import { isPublished } from '../../../lib/publication.mjs';

export async function getStaticPaths() {
  const resources = await getCollection('course-resources', isPublished);
  return resources.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, '') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'course-resources'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<CoursePage entry={entry} eyebrow="Printable worksheet">
  <div class="prose">
    <Content />
  </div>
</CoursePage>
