---
interface Props { section?: string }
const { section } = Astro.props;
const _base = import.meta.env.BASE_URL;
const base = _base.endsWith('/') ? _base : _base + '/';
const nav = [
  { href: '#projects', label: 'Work', section: 'projects' },
  { href: 'molecular-physiology.html', label: 'Atlas', section: 'physiology' },
  { href: '#notes', label: 'Notes', section: 'notes' },
  { href: '#writing', label: 'Writing', section: 'writing' },
  { href: '#about', label: 'About', section: 'about' },
];
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href={base} aria-current={!section ? 'page' : undefined}>Nicholas J. Sisco</a>
    <nav aria-label="Primary"><ul>{nav.map((item) => (
      <li><a href={`${base}${item.href}`} aria-current={section === item.section ? 'location' : undefined}>{item.label}</a></li>
    ))}</ul></nav>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .inner { max-width: var(--shell-maxw); margin: 0 auto; padding: 1.65rem 1.25rem; display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; justify-content: space-between; }
  .brand { font-family: var(--font-head); font-weight: 600; font-size: 1.5rem; line-height: 1.2; color: var(--ink); text-decoration: none; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.65rem; }
  nav li { margin: 0; }
  nav a { display: inline-block; padding: .3rem 0; color: var(--muted); text-decoration: none; font-size: 1rem; }
  nav a:hover, nav a[aria-current="location"] { color: var(--ink); text-decoration: underline; text-underline-offset: .4rem; }
  @media (max-width: 560px) {
    .inner { padding: 1.25rem 1rem; }
    nav { width: 100%; }
    nav ul { gap: .1rem 1.25rem; }
  }
</style>
