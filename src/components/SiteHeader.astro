---
interface Props { section?: string }
const { section } = Astro.props;
const _base = import.meta.env.BASE_URL;
const base = _base.endsWith('/') ? _base : _base + '/';
const nav: [string, string][] = [
  ['#projects', 'Projects'], ['#physiology', 'Physiology'], ['#notes', 'Notes'],
  ['#methods', 'Methods'], ['#writing', 'Writing'], ['#about', 'About'],
];
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href={base} aria-current={!section ? 'page' : undefined}>Nicholas Sisco <span>Independent Research &amp; Engineering</span></a>
    <nav aria-label="Primary"><ul>{nav.map(([href, label]) => (
      <li><a href={`${base}${href}`} aria-current={section === label.toLowerCase() ? 'location' : undefined}>{label}</a></li>
    ))}</ul></nav>
  </div>
</header>
<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--line); }
  .inner { max-width: var(--maxw); margin: 0 auto; padding: 1rem 1.25rem; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; align-items: baseline; justify-content: space-between; }
  .brand { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; color: var(--ink); text-decoration: none; }
  .brand span { display: block; font-family: var(--font-body); font-weight: 400; font-size: .8rem; color: var(--muted); }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.1rem; }
  nav a { color: var(--muted); text-decoration: none; font-size: .95rem; }
  nav a:hover, nav a[aria-current="location"] { color: var(--accent-ink); }
  @media (max-width: 560px) { .inner { padding: .85rem 1rem; } }
</style>
