---
/* SiteFooter.
 * NOTE: footer content was not recovered from the previous site
 * (inventory §8). Minimal reconstruction: identity line + read-only notice
 * (the site is confirmed read-only with no public participation). */
---
<footer class="site-footer">
  <div class="inner">
    <p><strong>Nicholas Sisco — Independent Research &amp; Engineering</strong></p>
    <p class="fine">
      A durable public record of independent scientific and technical work.
      Read-only: no comments, accounts, or submissions.
      Independent work only — nothing here is derived from employer projects.
    </p>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--surface-tint);
    margin-top: 3rem;
  }
  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 1.75rem 1.25rem;
  }
  .inner p { margin: 0 0 0.4rem; }
  .fine { color: var(--muted); font-size: 0.88rem; }
</style>
